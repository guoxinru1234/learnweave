# LearnMate LLM 配置
# 复制此文件为 .env 并填入你的 API Key

# === 选择提供商 (openai / deepseek / qwen / zhipu / moonshot / ollama / groq / custom) ===
LLM_PROVIDER=auto

# OpenAI 兼容中转服务（例如 APINebula；地址和模型名以服务商控制台为准）
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=your-api-key
# LLM_MODEL=your-model-name

# === OpenAI ===
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# === DeepSeek (推荐：便宜、中文好) ===
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat

# === 通义千问 (阿里云) ===
# DASHSCOPE_API_KEY=sk-xxx
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen-plus

# === 智谱 GLM (清华) ===
# ZHIPU_API_KEY=xxx
# LLM_PROVIDER=zhipu
# LLM_MODEL=glm-4-flash

# === Kimi (月之暗面) ===
# MOONSHOT_API_KEY=sk-xxx
# LLM_PROVIDER=moonshot
# LLM_MODEL=moonshot-v1-8k

# === Ollama (本地，免费) ===
# 先运行: ollama pull qwen2.5:7b
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b

# === Groq (免费额度，速度快) ===
# GROQ_API_KEY=gsk_xxx
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b

# === 通用配置 ===
LLM_MODEL=auto
# EMBEDDING_MODEL=text-embedding-3-small

# === 服务配置 ===
CORS_ORIGINS=*
NEXT_PUBLIC_API_URL=http://localhost:8002
BACKEND_PORT=8002
FRONTEND_PORT=3000

# Optional video generation via XFYun digital human (does not block audit)
ENABLE_VIDEO_GENERATION=false
